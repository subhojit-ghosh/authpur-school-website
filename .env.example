# Copy to .env.local for local development.

# Database (PostgreSQL).
#   Local development: leave DATABASE_URL unset — an embedded Postgres (PGlite)
#   stores its files in ./data/pg automatically (override with PGLITE_DIR).
#   Production (Neon): the pooled connection string from the Neon dashboard, e.g.
#   postgres://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=
# PGLITE_DIR=./data/pg

# Used only by `bun run db:seed` to create / reset the staff login.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_DISPLAY_NAME=School Office

# Where uploaded images are stored locally (served at /uploads/...). Defaults to ./data/uploads
# UPLOADS_DIR=./data/uploads

# Cloud image storage (production). Vercel sets this automatically when a Blob
# store is connected to the project; when present, uploads go to Vercel Blob
# instead of the local uploads folder.
# BLOB_READ_WRITE_TOKEN=
