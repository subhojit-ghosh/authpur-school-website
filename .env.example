# Copy to .env.local for local development.

# Database.
#   Local development: a SQLite file (folder is created automatically).
#   Cloud (Turso / libSQL): libsql://<db-name>-<org>.turso.io plus DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/school.db
# DATABASE_AUTH_TOKEN=

# Used only by `npm run db:seed` to create / reset the staff login.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_DISPLAY_NAME=School Office

# Where uploaded images are stored locally (served at /uploads/...). Defaults to ./data/uploads
# UPLOADS_DIR=./data/uploads

# Cloud image storage (production). Vercel sets this automatically when a Blob
# store is connected to the project; when present, uploads go to Vercel Blob
# instead of the local uploads folder.
# BLOB_READ_WRITE_TOKEN=
