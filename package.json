{
  "name": "authpur-national-model-school",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pglite-server --db ./data/pg --port 54329 -m 20 --include-database-url --run \"next dev\"",
    "build": "npm run db:migrate && npm run db:seed-content && next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-admin.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:seed-content",
    "db:seed-content": "node --env-file-if-exists=.env.local scripts/seed-content.mjs",
    "db:copy-from-sqlite": "node --env-file-if-exists=.env.local scripts/copy-from-sqlite.mjs",
    "build:local": "pglite-server --db ./data/pg --port 54329 -m 20 --include-database-url --run \"npm run build\"",
    "start:local": "pglite-server --db ./data/pg --port 54329 -m 20 --include-database-url --run \"next start -p 3001\"",
    "db:local": "pglite-server --db ./data/pg --port 54329 -m 20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.7",
    "shadcn": "^4.14.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
