{
  "name": "authpur-national-model-school",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "mkdir -p data && pglite-server --db ./data/pg --port 54329 -m 20 --include-database-url --run \"next dev\"",
    "build": "bun run db:migrate && bun run db:seed-content && next build",
    "start": "next start",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run lint",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.mjs",
    "db:seed": "bun scripts/seed-admin.mjs",
    "db:seed-content": "bun scripts/seed-content.mjs",
    "db:setup": "bun run db:migrate && bun run db:seed && bun run db:seed-content",
    "db:copy-from-sqlite": "bun scripts/copy-from-sqlite.mjs",
    "build:local": "mkdir -p data && pglite-server --db ./data/pg --port 54329 -m 20 --include-database-url --run \"bun run build\"",
    "start:local": "mkdir -p data && pglite-server --db ./data/pg --port 54329 -m 20 --include-database-url --run \"next start -p 3001\"",
    "db:local": "mkdir -p data && pglite-server --db ./data/pg --port 54329 -m 20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.46.0",
    "motion": "^13.4.1",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.17.7",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4",
    "typescript": "^7.0.2"
  }
}
